  "posts": [
    {
      "id": "pst_1",
      "authorId": "usr_elena",
      "content": "Spent the morning auditing our editorial grid proportions. Switching from arbitrary 12px card padding to strict harmonic ratios immediately calmed down every dense view in the app.",
      "imageUrl": "/media/post-architecture.svg",
      "imageAlt": "Editorial grid proportion study on drafting board",
      "createdAt": "2026-11-20T17:40:51.243Z"
    },
    {
      "id": "pst_2",
      "authorId": "usr_marcus",
      "content": "First light breaking over the basalt headlands at 05:40. Twenty minutes of clear stillness before the coastal fog rolled back in across the channel.",
      "imageUrl": "/media/post-topography.svg",
      "imageAlt": "Coastal horizon study at dawn",
      "createdAt": "2026-11-20T16:33:51.243Z"
    },
    {
      "id": "pst_3",
      "authorId": "usr_priya",
      "content": "Hot take: most social web apps feel sluggish not because of network latency, but because they block simple actions like liking or following behind full feed refetches. Optimistic state + idempotent REST endpoints solve 95% of it.",
      "createdAt": "2026-11-20T14:58:51.243Z"
    },
    {
      "id": "pst_4",
      "authorId": "usr_julian",
      "content": "Unloaded the reduction kiln after a 36-hour cool-down. This matte iron-speckled glaze finally settled into the exact warm limestone finish I have been testing since September.",
      "imageUrl": "/media/post-ceramics.svg",
      "imageAlt": "Stoneware vessels on studio timber shelf",
      "createdAt": "2026-11-20T12:48:51.243Z"
    },
    {
      "id": "pst_5",
      "authorId": "usr_claire",
      "content": "Visited a neighborhood lending library in Croix-Rousse that catalogs every margin note left by previous readers in a physical ledger at the front desk. Instant community memory.",
      "createdAt": "2026-11-20T09:08:51.243Z"
    },
    {
      "id": "pst_6",
      "authorId": "usr_elena",
      "content": "Reminder when building typography scales: tabular numerals (font-variant-numeric: tabular-nums) are non-negotiable anywhere counters tick up or down live.",
      "createdAt": "2026-11-19T18:08:51.243Z"
    }
  ],
